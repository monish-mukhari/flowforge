APP_ENV=production
APP_DOMAIN=automations.example.com
APP_PUBLIC_URL=https://automations.example.com
CORS_ORIGINS=https://automations.example.com
REQUIRE_EMAIL_VERIFICATION=false
NEXT_PUBLIC_HOOKS_URL=https://automations.example.com/hooks/catch
BACKEND_INTERNAL_URL=http://primary-backend:3002

# Generate independent random values with at least 32 characters.
JWT_PASSWORD=replace-with-a-unique-production-signing-secret
CONNECTION_ENCRYPTION_KEY=replace-with-a-unique-connection-encryption-key
SOLANA_WALLET_ENCRYPTION_KEY=replace-with-a-unique-wallet-encryption-key

# Use a managed PostgreSQL URL in production when possible.
DATABASE_URL=postgresql://flowforge:replace-with-a-unique-database-password@postgres:5432/flowforge?schema=public
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DB=flowforge

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_ENDPOINT=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com

SOLANA_RPC_URL=https://api.devnet.solana.com
WORKER_CONCURRENCY=4
WORKER_LEASE_MS=30000
ACTION_TIMEOUT_MS=20000
RETRY_BASE_MS=1000
LOG_LEVEL=info
