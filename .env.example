# Required outside local development. Generate at least 32 random characters.
JWT_PASSWORD=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

# Runtime address the web server uses for same-origin /api proxy requests.
# Docker Compose supplies http://primary-backend:3002 automatically; this
# localhost value is only for running the web and backend directly on the host.
BACKEND_INTERNAL_URL=http://localhost:3002

# Public browser-facing webhook address. The default works for local Compose.
NEXT_PUBLIC_HOOKS_URL=http://localhost:3001/hooks/catch

# Required only when a workflow contains a real Solana transfer action.
SOL_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional SMTP overrides. Docker Compose uses Mailpit by default.
SMTP_ENDPOINT=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@flowforge.local

# Reliable execution controls.
WORKER_CONCURRENCY=4
WORKER_LEASE_MS=30000
ACTION_TIMEOUT_MS=20000
RETRY_BASE_MS=1000
