# Required outside local development. Generate at least 32 random characters.
JWT_PASSWORD=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

# Public browser-facing addresses. Defaults work for local Docker Compose.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_HOOKS_URL=http://localhost:3001/hooks/catch

# Required only when a workflow contains a real Solana transfer action.
SOL_PRIVATE_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional SMTP overrides. Docker Compose uses Mailpit by default.
SMTP_ENDPOINT=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@flowforge.local
