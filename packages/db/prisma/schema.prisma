generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ZapStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum ZapRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum RunStepStatus {
  PENDING
  RUNNING
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

enum RunAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
}

model User {
  id                      Int                      @id @default(autoincrement())
  name                    String
  email                   String                   @unique
  passwordHash            String                   @map("password")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  zaps                    Zap[]
  sessions                AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           Int       @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
}

model Zap {
  id               String               @id @default(uuid())
  userId           Int                  @map("user_id")
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String               @default("Untitled workflow")
  description      String?
  status           ZapStatus            @default(DRAFT)
  triggerId        String               @map("trigger_id")
  trigger          Trigger?
  actions          Action[]
  zapRuns          ZapRun[]
  versions         WorkflowVersion[]
  triggerCaptures  TestTriggerCapture[]
  publishedVersion Int?                 @map("published_version")
  publishedAt      DateTime?            @map("published_at")
  pausedAt         DateTime?            @map("paused_at")
  archivedAt       DateTime?            @map("archived_at")
  webhookToken     String               @unique @default(uuid()) @map("webhook_token")
  webhookSecret    String               @default(uuid()) @map("webhook_secret")
  requireSignature Boolean              @default(false) @map("require_signature")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, status, updatedAt])
}

model WorkflowVersion {
  id          String   @id @default(uuid())
  zapId       String   @map("zap_id")
  zap         Zap      @relation(fields: [zapId], references: [id], onDelete: Cascade)
  version     Int
  definition  Json
  publishedAt DateTime @default(now()) @map("published_at")
  zapRuns     ZapRun[]

  @@unique([zapId, version])
  @@index([zapId, publishedAt])
}

model TestTriggerCapture {
  id        String   @id @default(uuid())
  zapId     String   @map("zap_id")
  zap       Zap      @relation(fields: [zapId], references: [id], onDelete: Cascade)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([zapId, createdAt])
  @@index([expiresAt])
}

model Trigger {
  id        String           @id @default(uuid())
  zapId     String           @unique @map("zap_id")
  zap       Zap              @relation(fields: [zapId], references: [id], onDelete: Cascade)
  triggerId String           @map("trigger_id")
  metadata  Json             @default("{}")
  type      AvailableTrigger @relation(fields: [triggerId], references: [id])
}

model AvailableTrigger {
  id       String    @id @default(uuid())
  name     String
  image    String
  triggers Trigger[]
}

model Action {
  id           String          @id @default(uuid())
  zapId        String          @map("zap_id")
  zap          Zap             @relation(fields: [zapId], references: [id], onDelete: Cascade)
  actionId     String          @map("action_id")
  metadata     Json            @default("{}")
  type         AvailableAction @relation(fields: [actionId], references: [id])
  sortingOrder Int             @default(0) @map("sorting_order")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  @@index([zapId, sortingOrder])
}

model AvailableAction {
  id      String   @id @default(uuid())
  name    String
  image   String
  actions Action[]
}

model ZapRun {
  id                 String           @id @default(uuid())
  zapId              String           @map("zap_id")
  zap                Zap              @relation(fields: [zapId], references: [id], onDelete: Cascade)
  workflowVersionId  String?          @map("workflow_version_id")
  workflowVersion    WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)
  definitionSnapshot Json?            @map("definition_snapshot")
  zapRunOutbox       ZapRunOutbox?
  steps              ZapRunStep[]
  metadata           Json
  idempotencyKey     String?          @map("idempotency_key")
  status             ZapRunStatus     @default(QUEUED)
  replayOfId         String?          @map("replay_of_id")
  replayOf           ZapRun?          @relation("ZapRunReplays", fields: [replayOfId], references: [id], onDelete: SetNull)
  replays            ZapRun[]         @relation("ZapRunReplays")
  startedAt          DateTime?        @map("started_at")
  completedAt        DateTime?        @map("completed_at")
  lastError          String?          @map("last_error")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([zapId, idempotencyKey])
  @@index([zapId, createdAt])
  @@index([workflowVersionId])
  @@index([zapId, status, createdAt])
  @@index([replayOfId])
}

model ZapRunStep {
  id             String          @id @default(uuid())
  zapRunId       String          @map("zap_run_id")
  zapRun         ZapRun          @relation(fields: [zapRunId], references: [id], onDelete: Cascade)
  sortingOrder   Int             @map("sorting_order")
  actionType     String          @map("action_type")
  input          Json
  output         Json?
  status         RunStepStatus   @default(PENDING)
  attemptCount   Int             @default(0) @map("attempt_count")
  maxAttempts    Int             @default(3) @map("max_attempts")
  nextAttemptAt  DateTime        @default(now()) @map("next_attempt_at")
  leaseOwner     String?         @map("lease_owner")
  leaseExpiresAt DateTime?       @map("lease_expires_at")
  idempotencyKey String          @unique @map("idempotency_key")
  lastError      String?         @map("last_error")
  startedAt      DateTime?       @map("started_at")
  completedAt    DateTime?       @map("completed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  attempts       ZapRunAttempt[]

  @@unique([zapRunId, sortingOrder])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
}

model ZapRunAttempt {
  id            String           @id @default(uuid())
  zapRunStepId  String           @map("zap_run_step_id")
  zapRunStep    ZapRunStep       @relation(fields: [zapRunStepId], references: [id], onDelete: Cascade)
  attemptNumber Int              @map("attempt_number")
  status        RunAttemptStatus @default(RUNNING)
  workerId      String           @map("worker_id")
  errorCode     String?          @map("error_code")
  errorMessage  String?          @map("error_message")
  output        Json?
  startedAt     DateTime         @default(now()) @map("started_at")
  completedAt   DateTime?        @map("completed_at")

  @@unique([zapRunStepId, attemptNumber])
  @@index([status, startedAt])
}

model ZapRunOutbox {
  id          String   @id @default(uuid())
  zapRunId    String   @unique @map("zap_run_id")
  zapRun      ZapRun   @relation(fields: [zapRunId], references: [id], onDelete: Cascade)
  stage       Int      @default(0)
  availableAt DateTime @default(now()) @map("available_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([availableAt, createdAt])
}
